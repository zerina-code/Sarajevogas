  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

' --------------------------------------------------------------------------------------------------------
' -------------- Amir -- Lager Lista izvještaj - totali ----------------------------------------------
' --------------------------------------------------------------------------------------------------------
' ------------ Za izračun totala na Lager Lista izvještaju, kolona Ulazi ---------------------
' --------------------------------------------------------------------------------------------------------
Dim totalUlazi As Decimal = 0 'Deklarisi varijablu

'Deklarisi funkciju koja će prikupljati pojedinacne vrijednosti
Public Function SumUlazi(ByVal ulazi As Decimal) As Decimal
    totalUlazi += ulazi
    Return ulazi
End Function

' Prikazi tu sumarnu vrijednost tamo gdje se poziva ova funkcija (sum po lokaciji):
Public Function GetTotalUlazi() As Decimal
    Dim temp As Decimal = totalUlazi
    totalUlazi = 0 ' Reset za sljedeći izračun
    Return temp
End Function

' Deklarisi totalTotal za sumiranje sumarnih vrijednosti po lokacijama:
Dim grandTotalUlazi As Decimal = 0 

Public Function AddToGrandTotalUlazi(ByVal total As Decimal) As Decimal
    grandTotalUlazi += total
    Return total ' Prikazi total
End Function

Public Function GetGrandTotalUlazi() As Decimal
    Dim temp As Decimal = grandTotalUlazi
    grandTotalUlazi = 0 ' Reset za sljedeći izračun
    Return temp
End Function

' ------------ Za izračun totala na Lager Lista izvještaju, kolona Izlazi ---------------------
' --------------------------------------------------------------------------------------------------------
Dim totalIzlazi As Decimal = 0 'Deklarisi varijablu

'Deklarisi funkciju koja će prikupljati pojedinacne vrijednosti
Public Function SumIzlazi(ByVal izlazi As Decimal) As Decimal
    totalIzlazi += izlazi
    Return izlazi
End Function

' Prikazi tu sumarnu vrijednost tamo gdje se poziva ova funkcija (sum po lokaciji):
Public Function GetTotalIzlazi() As Decimal
    Dim temp As Decimal = totalIzlazi
    totalIzlazi = 0 ' Reset za sljedeći izračun
    Return temp
End Function

' Deklarisi totalTotal za sumiranje sumarnih vrijednosti po lokacijama:
Dim grandTotalIzlazi As Decimal = 0 

Public Function AddToGrandTotalIzlazi(ByVal total As Decimal) As Decimal
    grandTotalIzlazi += total
    Return total ' Prikazi total
End Function

Public Function GetGrandTotalIzlazi() As Decimal
    Dim temp As Decimal = grandTotalIzlazi
    grandTotalIzlazi = 0 ' Reset za sljedeći izračun
    Return temp
End Function
' --------------------------------------------------------------------------------------------------------
' ------------ Za izračun totala na Lager Lista izvještaju, kolona Vrijednost --------------
' --------------------------------------------------------------------------------------------------------
Dim totalVrijednost As Decimal = 0 'Deklarisi varijablu

'Deklarisi funkciju koja će prikupljati pojedinacne vrijednosti
Public Function SumVrijednost(ByVal vrijednosti As Decimal) As Decimal
    totalVrijednost += vrijednosti
    Return vrijednosti
End Function

' Prikazi tu sumarnu vrijednost tamo gdje se poziva ova funkcija (sum po lokaciji):
Public Function GetTotalVrijednost() As Decimal
    Dim temp As Decimal = totalVrijednost
    totalVrijednost = 0 ' Reset za sljedeći izračun
    Return temp
End Function

' Deklarisi totalTotal za sumiranje sumarnih vrijednosti po lokacijama:
Dim grandTotalVrijednost As Decimal = 0 

Public Function AddToGrandTotalVrijednost(ByVal total As Decimal) As Decimal
    grandTotalVrijednost += total
    Return total ' Prikazi total
End Function

Public Function GetGrandTotalVrijednost() As Decimal
    Dim temp As Decimal = grandTotalVrijednost
    grandTotalVrijednost = 0 ' Reset za sljedeći izračun
    Return temp
End Function
