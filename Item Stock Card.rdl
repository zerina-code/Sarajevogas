  <Code>Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Shared RunningQInput As New System.Collections.Hashtable

Public Function GetRunningQInput(ByVal CurrentPageNumber)

  Return IIF(CurrentPageNumber &gt; 0, RunningQInput(CurrentPageNumber), 0)

End Function

Public Function SetRunningQInput(ByVal CurrentPageTotal, ByVal CurrentPageNumber)

  RunningQInput(CurrentPageNumber) = CurrentPageTotal + GetRunningQInput(CurrentPageNumber - 1)

  Return RunningQInput(CurrentPageNumber)

End Function

