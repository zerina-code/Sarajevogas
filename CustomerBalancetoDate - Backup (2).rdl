                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">Molimo vas da jedan potvrđeni primjerak pošaljete na naš fax </Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
