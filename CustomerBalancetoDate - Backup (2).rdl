                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">Prema čl. 28.stav 4. Zakona o računovodstvu i reviziji u FBiH, na ovu našu konfirmaciju dužni ste odgovoriti u roku 8 dana, u protivnom povlačite kaznene odredbe u skladu sa čl.69. istog zakona.</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto" />
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">Ukoliko u tom roku ne primimo potvrdu ili osporavanje iskazanog stanja, smatraćemo da je usaglašavanje izvršeno i da je stanje iskazano na ovom obrascu potvrđeno.</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>8pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
