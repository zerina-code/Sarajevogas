                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">U skladu sa odredbama člana 28. Zakona o računovodstvu i reviziji u Federaciji Bosne i Hercegovine (sl. novine FBiH br. 83/09) dostavljamo Vam POTVRDU STANJA RAČUNA NA DAN </Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">=Fields!TodayFormatted.Value</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value xml:space="preserve" EvaluationMode="Auto"> </Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">Molimo Vas da provjerite priložene izvode i potvrdite ih Vašim potpisom ukoliko su tačni. Ukoliko se ne slažete s priloženim stanjima računa molimo navedite neslaganja u prostoru na dnu ove potvrde.</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto" />
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value EvaluationMode="Auto">Ovaj upit ne predstavlja zahtjev za plaćanje.</Value>
                                      <Style>
                                        <FontFamily>Segoe UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Normal</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
